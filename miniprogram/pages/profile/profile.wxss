.form { padding: 24rpx; }
.field { margin-bottom: 28rpx; }
.label { display: block; font-size: 26rpx; font-weight: 600; color: var(--ink-2); margin-bottom: 12rpx; }
.req { color: var(--red-deep); }
.input {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #fff;
  color: var(--ink);
}
.hint { display: block; font-size: 22rpx; color: var(--muted); margin-top: 10rpx; line-height: 1.5; }

.tag-wrap { display: flex; flex-wrap: wrap; margin-bottom: 14rpx; }
.tag {
  font-size: 24rpx;
  color: var(--teach);
  background: var(--teach-bg);
  border-radius: 8rpx;
  padding: 8rpx 18rpx;
  margin: 0 14rpx 12rpx 0;
}
.tag-x { color: var(--muted); margin-left: 6rpx; }
.tag-add { display: flex; align-items: center; }
.tag-add .input { flex: 1; }
.add-btn {
  flex: 0 0 auto;
  margin-left: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: var(--ink-2);
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
}

.btn-primary {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--red-deep);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(194, 24, 61, 0.25);
}
.btn-primary:active { opacity: .9; }
