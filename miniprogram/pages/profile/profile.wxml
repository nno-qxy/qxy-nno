<view class="page">
  <view class="form">

    <view class="field">
      <text class="label">学号 <text class="req">*</text></text>
      <input
        class="input"
        type="number"
        maxlength="15"
        placeholder="请输入 8-15 位学号"
        value="{{form.studentId}}"
        data-key="studentId"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="label">姓名 <text class="req">*</text></text>
      <input
        class="input"
        maxlength="10"
        placeholder="请输入真实姓名"
        value="{{form.realName}}"
        data-key="realName"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="label">年级</text>
      <input
        class="input"
        maxlength="10"
        placeholder="如：大三"
        value="{{form.grade}}"
        data-key="grade"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="label">专业</text>
      <input
        class="input"
        maxlength="20"
        placeholder="如：计算机科学与技术"
        value="{{form.major}}"
        data-key="major"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="label">联系方式</text>
      <input
        class="input"
        maxlength="40"
        placeholder="手机号 / 微信，用于交换双方沟通"
        value="{{form.contact}}"
        data-key="contact"
        bindinput="onInput"
      />
      <text class="hint">联系方式在帖子详情页展示，广场列表不展示</text>
    </view>

    <view class="field">
      <text class="label">技能标签</text>
      <view class="tag-wrap">
        <view class="tag" wx:for="{{tags}}" wx:for-item="t" wx:key="*this" data-index="{{index}}" bindtap="onRemoveTag">
          {{t}} <text class="tag-x">×</text>
        </view>
      </view>
      <view class="tag-add">
        <input
          class="input"
          maxlength="10"
          placeholder="添加标签，最多 8 个"
          value="{{tagInput}}"
          bindinput="onTagInput"
          bindconfirm="onAddTag"
        />
        <view class="add-btn" bindtap="onAddTag">添加</view>
      </view>
    </view>

    <view class="btn-primary" bindtap="onSave">保 存</view>
  </view>
</view>
