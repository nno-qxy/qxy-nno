<view class="page">

  <!-- 用户卡 -->
  <view class="user-card">
    <view class="avatar lg" style="background:{{user.avatarColor || '#2B62E0'}}">{{initial}}</view>
    <view class="user-info">
      <view class="user-name">{{user.realName || user.nickname || '同学'}}</view>
      <view class="user-sub">
        <text wx:if="{{user.studentId}}">{{user.studentId}}</text>
        <text wx:if="{{user.major}}"> · {{user.major}}</text>
        <text wx:if="{{!user.studentId}}">尚未完善个人信息</text>
      </view>
    </view>
    <view class="rate">
      <view class="rate-num">{{user.goodCount || 0}}</view>
      <view class="rate-label">好评</view>
    </view>
    <view class="rate">
      <view class="rate-num">{{rateText}}</view>
      <view class="rate-label">好评率</view>
    </view>
  </view>

  <!-- 入口列表 -->
  <view class="grp">我的内容</view>
  <view class="entry-list">
    <view class="entry" bindtap="goMyPosts">
      <text class="entry-title">我的发布</text>
      <text class="entry-sub">查看发布记录与审核状态</text>
      <text class="entry-arrow">›</text>
    </view>
    <view class="entry" bindtap="goExchanges">
      <text class="entry-title">我的交换</text>
      <text class="entry-sub">进行中 / 待评价 / 已结束</text>
      <text class="entry-arrow">›</text>
    </view>
    <view class="entry" bindtap="goReceived">
      <text class="entry-title">收到的申请</text>
      <text class="entry-sub">确认或拒绝他人的交换申请</text>
      <text class="entry-arrow">›</text>
    </view>
  </view>

  <view class="grp">账号</view>
  <view class="entry-list">
    <view class="entry" bindtap="goProfile">
      <text class="entry-title">个人信息</text>
      <text class="entry-sub">学号、专业、技能标签、联系方式</text>
      <text class="entry-arrow">›</text>
    </view>
    <view class="entry" bindtap="goPrivacy">
      <text class="entry-title">隐私政策 / 用户协议</text>
      <text class="entry-sub">我们如何收集与使用你的信息</text>
      <text class="entry-arrow">›</text>
    </view>
  </view>

  <!-- 测试专用：仅沙盒模式（后端 SANDBOX_MODE）下可见，单设备模拟多账号验证交换全链路 -->
  <view class="test-zone" wx:if="{{testMode}}">
    <view class="test-head">
      <text class="test-tag">测试模式</text>
      <text class="test-cur">当前：{{testUid ? testUid : '真实微信账号'}}</text>
    </view>
    <view class="test-btn" bindtap="onSwitchTestAccount">切换测试账号</view>
    <view class="test-tip">沙盒环境专用，上线后自动隐藏</view>
  </view>

  <view class="logout" bindtap="onLogout">退出登录</view>
</view>
