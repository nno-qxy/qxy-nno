.user-card {
  display: flex;
  align-items: center;
  background: var(--card);
  margin: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 28rpx rgba(48, 48, 52, 0.07);
}
.avatar.lg {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 38rpx;
  font-weight: 600;
  flex: 0 0 auto;
}
.user-info { flex: 1; margin-left: 24rpx; min-width: 0; }
.user-name { font-size: 34rpx; font-weight: 600; color: var(--ink); }
.user-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rate { text-align: center; margin-left: 20rpx; min-width: 90rpx; }
.rate-num { font-size: 30rpx; font-weight: 600; color: var(--red-deep); }
.rate-label { font-size: 22rpx; color: var(--muted); margin-top: 2rpx; }

.grp {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--muted);
  padding: 16rpx 32rpx 10rpx;
}
.grp::before {
  content: "";
  width: 6rpx;
  height: 24rpx;
  border-radius: 2rpx;
  background: var(--line);
  margin-right: 12rpx;
}

.entry-list {
  background: var(--card);
  margin: 0 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 28rpx rgba(48, 48, 52, 0.07);
}
.entry {
  position: relative;
  padding: 28rpx 56rpx 28rpx 28rpx;
  border-bottom: 1rpx solid var(--line-soft);
}
.entry:last-child { border-bottom: none; }
.entry:active { background: var(--hover); }
.entry-title { display: block; font-size: 30rpx; color: var(--ink); }
.entry-sub { display: block; font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
.entry-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 34rpx;
  color: var(--muted);
}

.logout {
  margin: 48rpx 24rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--red-deep);
  background: var(--card);
  border-radius: 16rpx;
}

/* 测试模式区块：沙盒专用，用浅橙底与正常入口区分，提醒这是测试工具 */
.test-zone {
  margin: 32rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: #FFF7ED;
  border: 1rpx solid #FFD9B3;
  border-radius: 16rpx;
}
.test-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.test-tag {
  font-size: 24rpx;
  font-weight: 600;
  color: #C2410C;
  background: #FFE4CC;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.test-cur { font-size: 24rpx; color: #9A3412; }
.test-btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: #F97316;
  border-radius: 999rpx;
}
.test-btn:active { opacity: .88; }
.test-tip {
  font-size: 22rpx;
  color: #9A3412;
  text-align: center;
  margin-top: 14rpx;
  opacity: .8;
}
