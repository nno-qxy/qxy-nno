.card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 28rpx rgba(48, 48, 52, 0.07);
}
.card-hover { background: #FAFAFB; }

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.mark {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
.mark .arw { font-size: 26rpx; margin-right: 4rpx; }
.mark.teach { color: var(--teach); background: var(--teach-bg); }
.mark.learn { color: var(--learn); background: var(--learn-bg); }
.cat-text { font-size: 24rpx; color: var(--muted); }

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.tags { display: flex; flex-wrap: wrap; margin-bottom: 14rpx; }
.tag {
  font-size: 24rpx;
  color: #4B5563;
  background: var(--hover);
  border-radius: 6rpx;
  padding: 6rpx 16rpx;
  margin: 0 12rpx 8rpx 0;
}

.card-foot {
  display: flex;
  align-items: center;
  border-top: 1rpx solid var(--line-soft);
  padding-top: 16rpx;
}
.avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 12rpx;
  flex: 0 0 auto;
}
.who { font-size: 28rpx; color: var(--ink-2); font-weight: 500; }
.dot { color: var(--muted); font-size: 24rpx; margin: 0 6rpx; }
.time { font-size: 24rpx; color: var(--muted); margin-left: auto; }
