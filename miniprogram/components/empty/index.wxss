.empty {
  padding: 120rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-box {
  width: 120rpx;
  height: 96rpx;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  position: relative;
}
.empty-box::after {
  content: "";
  position: absolute;
  left: 50%;
  top: -18rpx;
  transform: translateX(-50%);
  width: 60rpx;
  height: 18rpx;
  border: 2rpx solid var(--line);
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
}
.empty-text { font-size: 28rpx; color: var(--muted); }
.empty-hint { font-size: 24rpx; color: var(--muted); margin-top: 10rpx; opacity: .8; }
