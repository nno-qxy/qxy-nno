/**
 * 设计 Token —— 与 原型设计/design-language.md 完全一致
 * 写页面样式时一律引用变量，禁止另发明配色
 */
page {
  --canvas: #F5F6F8;
  --card: #FFFFFF;
  --feed-bg: #F7F7F8;
  --ink: #1F2329;
  --ink-2: #2B2F38;
  --muted: #5F6776;
  --line: rgba(48, 48, 52, 0.10);
  --line-soft: rgba(48, 48, 52, 0.06);
  --hover: rgba(48, 48, 52, 0.05);

  /* 教 / 学：唯一用色编码「双向流动」 */
  --teach: #2B62E0;
  --teach-bg: rgba(43, 98, 224, 0.10);
  --learn: #7A3FE0;
  --learn-bg: rgba(122, 63, 224, 0.10);

  /* 唯一饱和强调色：只用于主 CTA */
  --red: #FF2442;
  --red-deep: #C2183D;

  /* 状态色：一律浅底 + 深字 */
  --ok: #1F8A4C;
  --ok-bg: rgba(31, 138, 76, 0.12);
  --warn: #C2410C;
  --warn-bg: rgba(194, 65, 12, 0.12);
  --pending: #5B6472;
  --pending-bg: rgba(91, 100, 114, 0.12);

  --shadow: 0 2rpx 14rpx rgba(48, 48, 52, 0.07);
  --shadow-lg: 0 8rpx 30rpx rgba(48, 48, 52, 0.12);
  --radius: 16rpx;
}
